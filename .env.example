# Credenciais locais de desenvolvimento. O Compose lê .env.
DB_USER=gerdau
DB_PASSWORD=gerdau_local
# Portas no Windows; as portas internas dos contêineres não mudam.
DB_PORT=5433
AI_PORT=8001
JAVA_PORT=8080
# Apenas para Java iniciado pela IDE/terminal fora do Docker.
# O Compose define seus próprios endereços internos db:5432 e ai:8001.
DB_URL=jdbc:postgresql://127.0.0.1:5433/gerdau
PYTHON_AI_URL=http://127.0.0.1:8001
